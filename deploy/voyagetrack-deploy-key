#!/usr/bin/env bash

set -euo pipefail

deny() {
  echo "Only 'load <sha>' or 'deploy <sha>' is allowed." >&2
  exit 64
}

read -r -a command_parts <<< "${SSH_ORIGINAL_COMMAND:-}"
[[ ${#command_parts[@]} -eq 2 ]] || deny
[[ "${command_parts[1]}" =~ ^[0-9a-f]{40}$ ]] || deny

case "${command_parts[0]}" in
  load)
    exec /usr/bin/sudo -n /usr/local/sbin/voyagetrack-load "${command_parts[1]}"
    ;;
  deploy)
    exec /usr/bin/sudo -n /usr/local/sbin/voyagetrack-deploy "${command_parts[1]}"
    ;;
  *)
    deny
    ;;
esac
